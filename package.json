{
  "name": "dice-craft",
  "version": "0.1.0",
  "description": "基于多Agent的桌游创作与游玩平台",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "run-p dev:backend dev:webui",
    "dev:backend": "bun run sync:skills && bun run src/index.ts",
    "dev:webui": "cd packages/dice-craft-webui && bun run dev",
    "sync:skills": "test -d data/workspaces/ws_default && rm -rf data/workspaces/ws_default/skills && cp -r templates/skills data/workspaces/ws_default/skills || true",
    "build:webui": "cd packages/dice-craft-webui && bun run build",
    "test": "bun test tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src/ tests/",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun test tests/ && bunx tsc --noEmit && eslint src/ tests/ && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "hono": "^4.12.23",
    "openai": "^6.39.0",
    "zod": "^4.4.3"
  }
}
